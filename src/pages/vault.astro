---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import VaultSections from '../components/VaultSections.astro';
import CompareTable from '../components/CompareTable.astro';
import FakeDoorButton from '../components/FakeDoorButton.astro';
import EmailCapture from '../components/EmailCapture.astro';
import AskAI from '../components/AskAI.astro';
import { breadcrumbSchema, faqSchema } from '../lib/schema';
import { SITE } from '../lib/site';
import { vaultFaq } from '../lib/faq';

const crumbs = [{ name: 'Home', url: '/' }, { name: 'Secure Vault for Mac', url: '/vault/' }];
const app = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Secure Vault for Mac', operatingSystem: 'macOS',
  applicationCategory: 'UtilitiesApplication', description: 'Encrypted vault for photos and files on Mac. Currently in private beta.', url: `${SITE}/vault/`,
};
---
<Base
  title="Secure Vault for Mac: Lock Photos & Files (Beta)"
  description="Secure Vault for Mac keeps photos and files encrypted with AES-256 and unlocks with Touch ID. Join the private beta waitlist."
  path="/vault/"
  alternates={{ en: '/vault/', 'x-default': '/vault/' }}
  jsonLd={[app, breadcrumbSchema(crumbs), faqSchema(vaultFaq)].filter(Boolean)}
  brandSuffix={false}
>
  <Hero />
  <div class="spacer"></div>
  <VaultSections />
  <section class="section alt tight">
    <div class="container narrow">
      <div class="section-head reveal"><p class="eyebrow">Requirements</p><h2>What you'll need.</h2></div>
      <CompareTable head={['Requirement', 'Planned']} rows={[['macOS', '14 Sonoma or later'], ['Chip', 'Apple silicon and Intel'], ['Unlock', 'Touch ID or password'], ['Account', 'None'], ['Network', 'Not required']]} caption="System requirements" />
      <p class="muted small">Requirements may change before release.</p>
      <h3>Changelog</h3>
      <p class="muted">Nothing has shipped yet. Release notes will appear here when the beta starts.</p>
    </div>
  </section>
  <section class="section tight"><div class="container narrow"><EmailCapture source="vault" /><div style="margin-top:56px"><AskAI /></div></div></section>
</Base>
<style>
  .spacer { height: 60px; } .narrow { max-width: 760px; }
</style>
