---
import Base from '../layouts/Base.astro';
import VaultMockup from '../components/VaultMockup.astro';
import FakeDoorButton from '../components/FakeDoorButton.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { allPages, urlOf, langOf } from '../lib/content';
import { homeSchema } from '../lib/schema';
import { ui } from '../lib/i18n';

const all = (await allPages()).filter((p) => langOf(p) === 'en');
const pick = (ids: string[]) => ids.map((i) => all.find((p) => p.id === `en/${i}`)!).filter(Boolean);
const featured = pick(['guides/hide-files-on-mac', 'guides/password-protect-folder-on-mac', 'guides/hide-photos-on-mac']);
const best = pick(['best/photo-vault-apps-for-mac', 'best/file-encryption-apps-for-mac', 'best/free-privacy-apps-for-mac']);
---
<Base
  title="Secure Mac App: Privacy Guides & Encrypted Vault for Mac"
  description="Practical guides and honest comparisons for keeping files and photos private on a Mac, plus Secure Vault, our encrypted vault app for macOS."
  path="/"
  alternates={{ en: '/', ja: '/ja/', de: '/de/', 'x-default': '/' }}
  jsonLd={homeSchema()}
  brandSuffix={false}
>
  <div class="wrap">
    <section class="hero">
      <div>
        <p class="eyebrow">Mac privacy, in plain steps</p>
        <h1>Keep your files and photos private on your Mac</h1>
        <p class="lead">{ui.en.tagline} Every guide has real macOS steps, the limits of each method, and when a vault app is worth it.</p>
        <p class="cta"><a class="btn" href="/guides/">Browse the guides</a> <FakeDoorButton /></p>
        <p class="muted small">Secure Vault for Mac is in private beta. Join the waitlist.</p>
      </div>
      <VaultMockup />
    </section>

    <section aria-labelledby="featured">
      <h2 id="featured">Start here</h2>
      <div class="grid">
        {featured.map((p) => <a class="card" href={urlOf(p)}><h3>{p.data.h1 ?? p.data.title}</h3><p>{p.data.description}</p></a>)}
      </div>
    </section>

    <section aria-labelledby="best">
      <h2 id="best">Honest comparisons</h2>
      <div class="grid">
        {best.map((p) => <a class="card" href={urlOf(p)}><h3>{p.data.h1 ?? p.data.title}</h3><p>{p.data.description}</p></a>)}
      </div>
    </section>

    <section class="split" aria-labelledby="how">
      <div>
        <h2 id="how">How we test</h2>
        <p>We write each guide from the steps on a current version of macOS, name that version on the page, and list what the method does <em>not</em> protect. Apps in our comparisons are judged on the same criteria, and our own app is always labelled as ours. <a href="/about/#how-we-test">Read the details</a>.</p>
      </div>
      <div>
        <h2>Free tool</h2>
        <p><a href="/tools/hidden-file-checker/">Hidden File Checker</a>: paste a Terminal listing and see which files are hidden, and how. It runs in your browser, with no upload.</p>
      </div>
    </section>

    <EmailCapture source="home" />
  </div>
</Base>
<style>
  .hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.5rem; align-items: center; padding: 3rem 0 2rem; }
  .lead { font-size: 1.12rem; color: var(--text-2); max-width: 52ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .small { font-size: 0.85rem; }
  section > h2 { margin-top: 2.5rem; }
  .split { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
  @media (max-width: 820px) { .hero { grid-template-columns: 1fr; padding-top: 1.5rem; } }
</style>
