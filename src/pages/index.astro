---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import VaultSections from '../components/VaultSections.astro';
import Sky from '../components/Sky.astro';
import FakeDoorButton from '../components/FakeDoorButton.astro';
import AskAI from '../components/AskAI.astro';
import { allPages, urlOf, langOf } from '../lib/content';
import { homeSchema } from '../lib/schema';

const all = (await allPages()).filter((p) => langOf(p) === 'en');
const featured = ['guides/hide-files-on-mac', 'guides/password-protect-folder-on-mac', 'guides/hide-photos-on-mac'].map((i) => all.find((p) => p.id === `en/${i}`)!).filter(Boolean);
---
<Base
  title="Secure Mac App: Privacy Guides & Encrypted Vault for Mac"
  description="Practical guides and honest comparisons for keeping files and photos private on a Mac, plus Secure Vault, our encrypted vault app for macOS."
  path="/"
  alternates={{ en: '/', ja: '/ja/', de: '/de/', 'x-default': '/' }}
  jsonLd={homeSchema()}
  brandSuffix={false}
>
  <Hero />
  <div class="spacer"></div>
  <VaultSections />
  <section class="section tight">
    <div class="container">
      <div class="section-head reveal"><p class="eyebrow">Guides</p><h2>Start with the steps.</h2><p class="t-body-lg">Real macOS steps, honest limits, and when a vault app is worth it. <a href="/about/#how-we-test">How we test</a>.</p></div>
      <div class="grid">{featured.map((p) => <a class="card reveal" href={urlOf(p)}><h3>{p.data.h1 ?? p.data.title}</h3><p>{p.data.description}</p></a>)}</div>
      <p class="more"><a class="link-arrow" href="/guides/">All guides</a> <a class="link-arrow" href="/tools/hidden-file-checker/">Free Hidden File Checker</a></p>
    </div>
  </section>
  <Sky class="final">
    <div class="container fin">
      <h2 class="t-display">Your files. Your Mac. Locked.</h2>
      <p><FakeDoorButton /></p>
    </div>
  </Sky>
  <section class="section tight"><div class="container"><AskAI /></div></section>
</Base>
<style>
  .spacer { height: 60px; }
  .more { display: flex; gap: 28px; justify-content: center; margin-top: 32px; flex-wrap: wrap; }
  .final { min-height: 60vh; display: grid; place-items: center; }
  .final::after { display: none; }
  .fin { text-align: center; padding-block: 72px; } .fin h2 { max-width: 14ch; margin-inline: auto; }
</style>
