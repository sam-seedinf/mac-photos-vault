---
interface Props { title?: string; class?: string; label?: string }
const { title = '', class: cls = '', label } = Astro.props;
---
<figure class={`mac-window ${cls}`} role={label ? 'img' : undefined} aria-label={label}>
  <div class="titlebar" aria-hidden="true"><span class="tl red"></span><span class="tl yellow"></span><span class="tl green"></span><span class="title">{title}</span></div>
  <div aria-hidden={label ? 'true' : undefined}><slot /></div>
</figure>
