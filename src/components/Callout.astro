---
interface Props { type?: 'tip' | 'warning' | 'privacy' }
const { type = 'tip' } = Astro.props;
const label = { tip: 'Tip', warning: 'Warning', privacy: 'Privacy' }[type];
---
<aside class={`callout ${type}`} role="note"><strong>{label}</strong><div><slot /></div></aside>
<style>
  .callout { display: grid; gap: 4px; padding: 16px 20px; border-radius: var(--r-card); margin: 1.4em 0; background: var(--bg-alt); font-size: 16px; }
  .callout > strong { font-size: 13px; font-weight: 600; color: var(--accent-text); }
  .callout :global(p:last-child) { margin-bottom: 0; }
  .warning > strong { color: var(--warn-text); } .privacy > strong { color: var(--success-text); }
</style>
