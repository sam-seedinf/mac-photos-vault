---
import SubscribeForm from './SubscribeForm.astro';
import type { Lang } from '../lib/i18n';
interface Props { lang?: Lang; source?: string; heading?: string; text?: string }
const { lang = 'en', source = '', heading, text } = Astro.props;
const d = {
  en: ['Secure Vault for Mac is in private beta', 'Get the download link by email when it opens.'],
  ja: ['Secure Vault for Mac は非公開ベータ中です', 'ベータ公開時にダウンロードリンクをメールでお送りします。'],
  de: ['Secure Vault for Mac ist in der privaten Beta', 'Sie erhalten den Download-Link per E-Mail, sobald die Beta startet.'],
}[lang];
---
<section class="capture reveal" aria-labelledby={`cap-${source}`}>
  <h2 id={`cap-${source}`}>{heading ?? d[0]}</h2>
  <p class="muted">{text ?? d[1]}</p>
  <div class="f"><SubscribeForm lang={lang} source={source} compact /></div>
</section>
<style>
  .capture { margin: 56px 0 0; padding: clamp(28px, 5vw, 48px); background: var(--bg-alt); border-radius: var(--r-card); text-align: center; }
  .capture h2 { margin: 0 0 8px; font-size: clamp(24px, 3vw, 32px); line-height: 1.15; }
  .f { max-width: 460px; margin: 20px auto 0; }
</style>
