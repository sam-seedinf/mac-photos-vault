---
interface Props { keys: string | string[] }
const { keys } = Astro.props;
const list = Array.isArray(keys) ? keys : [...keys];
---
<span class="kbd-group" role="img" aria-label={list.join(' ')}>{list.map((k) => <kbd aria-hidden="true">{k}</kbd>)}</span>
<style>.kbd-group { display: inline-flex; gap: 4px; vertical-align: baseline; }</style>
