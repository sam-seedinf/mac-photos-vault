---
interface Props { crumbs: { name: string; url: string }[] }
const { crumbs } = Astro.props;
---
<nav aria-label="Breadcrumb" class="bc">
  <ol>{crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}</ol>
</nav>
<style>
  .bc ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0 0 20px; font-size: 14px; color: var(--text-3); }
  .bc li:not(:last-child)::after { content: "›"; margin-left: 6px; }
  .bc a { color: var(--text-2); }
</style>
