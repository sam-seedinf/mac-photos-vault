---
import { ui, type Lang } from '../lib/i18n';
interface Props {
  item: { name: string; tagline: string; price: string; platforms: string; openSource: boolean | null; url?: string; ours?: boolean; affiliate?: boolean; bestFor: string; pros: string[]; cons: string[] };
  lang?: Lang; rank?: number;
}
const { item, lang = 'en', rank } = Astro.props;
const initial = item.name.trim()[0]?.toUpperCase() ?? '?';
const rel = item.affiliate ? 'nofollow sponsored noopener' : 'noopener';
---
<article class="app">
  <div class="icon" aria-hidden="true">{initial}</div>
  <div class="body">
    <h3>{rank ? `${rank}. ` : ''}{item.url && !item.ours ? <a href={item.url} rel={rel} target="_blank" data-outbound data-app-name={item.name} data-affiliate={String(item.affiliate ?? false)}>{item.name}</a> : item.name}{item.ours && <span class="ours">{ui[lang].ours}</span>}</h3>
    <p class="tag">{item.tagline}</p>
    <p class="meta"><span class="price">{item.price}</span><span class="m">{item.platforms}{item.openSource ? ' · Open source' : ''}</span></p>
    <div class="pc">
      <ul class="pros">{item.pros.map((p) => <li>{p}</li>)}</ul>
      <ul class="cons">{item.cons.map((p) => <li>{p}</li>)}</ul>
    </div>
    {item.url && !item.ours && <a class="visit link-arrow" href={item.url} rel={rel} target="_blank" data-outbound data-app-name={item.name} data-affiliate={String(item.affiliate ?? false)}>Visit</a>}
  </div>
</article>
<style>
  .app { display: flex; gap: 20px; padding: 28px; margin-bottom: 16px; background: var(--bg-alt); border-radius: var(--r-card); }
  .icon { flex: none; width: 56px; height: 56px; border-radius: 14px; background: linear-gradient(160deg, #5aa7ee, #0071e3); display: grid; place-items: center; font-weight: 700; color: #fff; font-size: 24px; }
  .body { min-width: 0; flex: 1; }
  h3 { margin: 0 0 4px; font-size: 24px; }
  .ours { margin-left: 10px; font-size: 12px; font-weight: 600; padding: 2px 10px; border-radius: 99px; background: var(--accent); color: #fff; vertical-align: 3px; }
  .tag { margin: 0 0 8px; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; }
  .price { background: var(--bg); border: 0.5px solid var(--line); border-radius: 99px; padding: 2px 12px; font-size: 14px; }
  .meta .m { font-size: 14px; color: var(--text-2); padding: 2px 0; }
  .pc { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0 28px; }
  ul { margin: 0; padding: 0; list-style: none; font-size: 16px; }
  li { padding-left: 26px; position: relative; margin-bottom: 8px; }
  .pros li::before { content: "✓"; color: var(--success-text); position: absolute; left: 2px; font-weight: 700; }
  .cons li::before { content: "✕"; color: var(--text-3); position: absolute; left: 2px; font-weight: 700; }
  .visit { display: inline-block; margin-top: 8px; }
  @media (max-width: 734px) { .app { padding: 20px; gap: 14px; } .icon { width: 44px; height: 44px; font-size: 20px; } }
</style>
