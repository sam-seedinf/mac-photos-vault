---
import { ui, type Lang } from '../lib/i18n';
import { inline } from '../lib/inline';
interface Props { faq: { q: string; a: string }[]; lang?: Lang; bare?: boolean }
const { faq, lang = 'en', bare = false } = Astro.props;
---
{faq.length > 0 && (
  <section id="faq" class="faq">
    {!bare && <h2>{ui[lang].faq}</h2>}
    {faq.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p set:html={inline(f.a)} />
      </details>
    ))}
  </section>
)}
<style>
  details { border-bottom: 0.5px solid var(--line); }
  summary { cursor: pointer; font: 600 clamp(17px, 2vw, 21px)/1.3 var(--font-display); padding: 20px 40px 20px 0; list-style: none; position: relative; letter-spacing: 0.009em; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; position: absolute; right: 4px; top: 50%; margin-top: -14px; font: 300 28px/28px var(--font-text); color: var(--text-2); transition: transform 250ms var(--ease); }
  details[open] summary::after { transform: rotate(45deg); }
  details p { margin: 0 0 20px; color: var(--text-2); max-width: 62ch; }
</style>
