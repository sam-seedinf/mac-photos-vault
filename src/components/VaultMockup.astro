---
import MacWindow from './MacWindow.astro';
---
<MacWindow title="Secure Vault" class="mock">
  <div class="m" role="img" aria-label="Illustration of the Secure Vault window: a sidebar with Photos, Documents and Locked, and a grid of photo thumbnails with a padlock badge.">
    <div class="side">
      <span class="on">Photos</span><span>Documents</span><span>Receipts</span><span class="lock">🔒 Locked</span>
    </div>
    <div class="grid-m">
      {Array.from({ length: 8 }).map((_, i) => <i style={`--h:${(i * 47 + 210) % 360}`}></i>)}
    </div>
  </div>
</MacWindow>
<style>
  .mock { max-width: 560px; }
  .m { display: grid; grid-template-columns: 150px 1fr; min-height: 280px; }
  .side { background: var(--sidebar); border-right: 1px solid var(--line); padding: 0.8rem 0.6rem; display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.85rem; color: var(--text-2); }
  .side span { padding: 0.3rem 0.6rem; border-radius: 6px; }
  .side .on { background: var(--accent); color: var(--on-accent); }
  .side .lock { margin-top: auto; }
  .grid-m { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding: 12px; align-content: start; }
  .grid-m i { aspect-ratio: 1; border-radius: 8px; background: linear-gradient(135deg, hsl(var(--h) 55% 62%), hsl(calc(var(--h) + 40) 60% 48%)); filter: blur(0.4px); }
  @media (max-width: 520px) { .m { grid-template-columns: 1fr; } .side { display: none; } }
</style>
