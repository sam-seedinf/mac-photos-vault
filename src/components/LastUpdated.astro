---
import { fmtDate, isoDate } from '../lib/site';
import { ui, type Lang } from '../lib/i18n';
interface Props { date: Date; lang?: Lang; testedOn?: string; minutes?: number }
const { date, lang = 'en', testedOn, minutes } = Astro.props;
---
<p class="lu">{ui[lang].updated} <time datetime={isoDate(date)}>{fmtDate(date, lang)}</time>{minutes ? <> · {minutes} min read</> : null}{testedOn && <> · {ui[lang].testedOn} {testedOn}</>}</p>
<style>.lu { font-size: 14px; color: var(--text-3); margin: 0 0 24px; }</style>
