---
import { ui, type Lang } from '../lib/i18n';
interface Props { lang?: Lang; source?: string; app?: string; compact?: boolean }
const { lang = 'en', source = '', app = 'vault', compact = false } = Astro.props;
const t = ui[lang];
const cta = { en: 'Send me the link', ja: 'リンクを送ってもらう', de: 'Link senden' }[lang];
const id = `em-${source}-${app}-${compact}`;
---
<form class="sub" data-subscribe data-app={app} data-lang={lang} data-source={source} method="post" action="/api/subscribe" novalidate>
  <label class="sr-only" for={id}>{t.emailLabel}</label>
  <div class="row">
    <input id={id} type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
    <button type="submit" class="btn">{cta}</button>
  </div>
  <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
  <label class="opt"><input type="checkbox" name="tips" /> {t.tipsOpt}</label>
  <p class="micro">{t.emailMicro}</p>
  <p class="status" role="status" aria-live="polite" hidden></p>
</form>
<style>
  .row { display: flex; gap: 10px; flex-wrap: wrap; }
  input[type="email"] { flex: 1 1 220px; height: 48px; font: 400 17px var(--font-text); padding: 0 20px; border-radius: var(--r-pill); border: 1px solid var(--line); background: var(--bg); color: var(--text); letter-spacing: -0.022em; }
  input[type="email"]:focus { outline: 3px solid color-mix(in srgb, var(--accent) 40%, transparent); border-color: var(--accent); }
  .row .btn { height: 48px; }
  .hp { position: absolute; left: -9999px; }
  .opt { display: flex; gap: 8px; align-items: center; justify-content: center; font-size: 14px; margin-top: 14px; color: var(--text-2); }
  .micro { font-size: 13px; color: var(--text-3); margin: 8px 0 0; }
  .status { margin: 10px 0 0; font-weight: 600; font-size: 15px; }
  .status.err { color: var(--danger); } .status.ok { color: var(--success-text); }
</style>
