---
import '../styles/global.css';
import { ui, htmlLang, reviewedLangs, type Lang } from '../lib/i18n';
import { NAME, GA_ID, CLARITY_ID, abs } from '../lib/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FakeDoorModal from '../components/FakeDoorModal.astro';

interface Props {
  title: string;
  description: string;
  path: string; // canonical path, e.g. /guides/foo/
  lang?: Lang;
  alternates?: Record<string, string>;
  switchTargets?: Partial<Record<Lang, string>>;
  noindex?: boolean;
  og?: string;
  jsonLd?: unknown[];
  type?: 'website' | 'article';
  brandSuffix?: boolean;
}
const {
  title, description, path, lang = 'en', alternates = {}, switchTargets, noindex = !reviewedLangs[lang as Lang],
  og = '/og/default.png', jsonLd = [], type = 'website', brandSuffix = true,
} = Astro.props;

const t = ui[lang];
const fullTitle = brandSuffix && `${title} | ${NAME}`.length <= 60 ? `${title} | ${NAME}` : title;
const canonical = abs(path);
const robots = noindex ? 'noindex, follow' : null;
const nav = {
  en: { guides: '/guides/', best: '/best/' },
  ja: { guides: '/ja/#guides', best: '/ja/best/photo-vault-apps/' },
  de: { guides: '/de/#guides', best: '/best/' },
}[lang];
const targets = switchTargets ?? { en: '/', ja: '/ja/', de: '/de/' };
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    {Object.entries(alternates).map(([hl, href]) => <link rel="alternate" hreflang={hl} href={abs(href)} />)}
    <meta property="og:site_name" content={NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(og)} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : lang === 'ja' ? 'ja_JP' : 'de_DE'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(og)} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { var th = localStorage.getItem('theme'); if (th) document.documentElement.dataset.theme = th; } catch (e) {}
    </script>
    {GA_ID && (
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('consent','default',{analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',wait_for_update:500});
        gtag('js', new Date());
        gtag('config', GA_ID);
        var s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
      </script>
    )}
    {jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body data-lang={lang} data-ga={GA_ID ? '1' : '0'} data-clarity={CLARITY_ID}>
    <a class="skip" href="#main">Skip to content</a>
    <Nav lang={lang} path={path} targets={targets} links={nav} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <FakeDoorModal lang={lang} />

    {(GA_ID || CLARITY_ID) && (
      <div id="consent" role="region" aria-label="Cookie consent" hidden>
        <p>We use analytics cookies to see which guides help. Nothing is shared for ads. <a href="/privacy/">Details</a></p>
        <div><button class="btn sm" data-consent="granted">Accept</button> <button class="btn sm secondary" data-consent="denied">Decline</button></div>
      </div>
    )}
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
